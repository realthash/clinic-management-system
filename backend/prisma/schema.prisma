// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Hospital {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  address   String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  departments Department[]
  staffs      Staff[]

  @@index([deletedAt])
  @@map("hospital")
}

model Department {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  hospitalId String    @map("hospital_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  //RELATIONSHIPS
  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  staffs   Staff[]
  clinics  Clinic[]

  //avoid department name duplication  in a single hospital
  @@unique([hospitalId, name])
  @@index([hospitalId])
  @@index([deletedAt])
  @@map("department")
}

model Staff {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  email        String    @unique
  password     String
  role         Role
  isActive     Boolean   @default(true) @map("is_active")
  deletedAt    DateTime? @map("deleted_at")
  staffId      String    @unique @map("staff_id")
  hospitalId   String    @map("hospital_id") @db.Uuid
  departmentId String?   @map("department_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  //RELATIONSHIPS
  hospital   Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId], references: [id])

  sessions Session[]

  @@index([hospitalId])
  @@index([deletedAt])
  @@map("staff")
}

enum Role {
  DOCTOR
  NURSE
  HOSPITAL_ADMIN
}

model Clinic {
  id           String    @id @default(uuid()) @db.Uuid
  departmentId String    @map("department_id") @db.Uuid
  name         String
  category     String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  //RELATIONSHIPS
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  sessions Session[]

  //avoid clinic name duplication  in a single department
  @@unique([departmentId, name])
  @@index([departmentId])
  @@index([deletedAt])
  @@map("clinic")
}

model Session {
  id              String        @id @default(uuid()) @db.Uuid
  clinicId        String        @map("clinic_id") @db.Uuid
  sessionName     String        @map("session_name")
  sessionStatus   SessionStatus @default(SCHEDULED) @map("session_status")
  startsAt        DateTime      @map("starts_at")
  endsAt          DateTime?     @map("ends_at")
  sessionCapacity Int           @map("session_capacity")
  venue           String?
  description     String?
  createdBy       String        @map("created_by") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  //RELATIONSHIPS
  clinic  Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  creator Staff  @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  sessionPatients SessionPatient[]

  @@index([createdBy])
  @@index([startsAt])
  @@map("session")
}

enum SessionStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

model SessionPatient {
  id          String       @id @default(uuid()) @db.Uuid
  bookingType BookingType  @default(SELF_BOOKED) @map("booking_type")
  status      ActiveStatus @default(SCHEDULED)
  tokenNumber Int?         @map("token_number")
  assignedBy  String?      @map("assigned_by") @db.Uuid
  checkedInAt DateTime?    @map("checked_in_at")
  completedAt DateTime?    @map("completed_at")
  sessionId   String       @map("session_id") @db.Uuid
  patientId   String       @map("patient_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  //RELATIONSHIPS
  session Session @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  // Avoid duplicate bookings, ensures a patient cannot be booked more than once in the same session
  @@unique([sessionId, patientId])
  // Ensure token numbers are unique within a session
  @@unique([sessionId, tokenNumber])
  //find only patientId 
  @@index([patientId])
  @@map("session_patient")
}

enum BookingType {
  ASSIGNED
  SELF_BOOKED
}

enum ActiveStatus {
  SCHEDULED
  CHECKED_IN
  NO_SHOW
  COMPLETED
  CANCELLED
}

model Patient {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  nic       String
  phone     String
  email     String?  @unique
  password  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessionPatients SessionPatient[]

  @@map("patient")
}
